# Safe local names and non-secret defaults only.
CAREERPILOT_ENVIRONMENT=local
CAREERPILOT_LOG_LEVEL=INFO
CAREERPILOT_API_HOST=127.0.0.1
CAREERPILOT_API_PORT=8000
CAREERPILOT_WEB_PORT=3000
CAREERPILOT_POSTGRES_HOST=127.0.0.1
CAREERPILOT_POSTGRES_PORT=5432
CAREERPILOT_POSTGRES_DB=careerpilot
CAREERPILOT_POSTGRES_USER=careerpilot
# Set only a synthetic local password in the ignored .env file.
CAREERPILOT_POSTGRES_PASSWORD=
CAREERPILOT_DATABASE_URL=
CAREERPILOT_TEST_DATABASE_URL=
NEXT_PUBLIC_CAREERPILOT_API_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
CAREERPILOT_ADK_ENABLED=true
CAREERPILOT_ADK_PROVIDER=fake
CAREERPILOT_ADK_MODEL=gemini-3.6-flash
CAREERPILOT_ADK_TIMEOUT_SECONDS=20
CAREERPILOT_ADK_LIVE_EVAL_COST_APPROVED=false
CAREERPILOT_OPENAI_AGENTS_ENABLED=true
CAREERPILOT_OPENAI_AGENTS_PROVIDER=fake
CAREERPILOT_OPENAI_AGENTS_MODEL=gpt-5.6-luna
CAREERPILOT_OPENAI_AGENTS_TRACE_EXPORT=false
CAREERPILOT_OPENAI_AGENTS_LIVE_COST_APPROVED=false
CAREERPILOT_OPENAI_AGENTS_MAX_COST_CHF=0
CAREERPILOT_ADK_PORT=8101
CAREERPILOT_OPENAI_PORT=8102
CAREERPILOT_TEMPORAL_PORT=7233
CAREERPILOT_TEMPORAL_UI_PORT=8233
