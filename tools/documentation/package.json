{
  "name": "@careerpilot/documentation-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "links": "markdown-link-check --config markdown-link-check.json --quiet ../../*.md ../../docs/*.md ../../docs/**/*.md ../../docs/**/**/*.md",
    "lint": "markdownlint-cli2 --config markdownlint-cli2.jsonc ../../*.md ../../docs/**/*.md ../../docs/**/**/*.md"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.16.0",
    "markdown-link-check": "3.15.0",
    "markdownlint-cli2": "0.23.2"
  }
}
